{
  "name": "beach-finder",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build:ui": "npm run build -w @beach-finder/ui",
    "build:app": "esbuild src/main.jsx --bundle --minify --jsx=automatic --outfile=dist/app.js && cp packages/ui/dist/styles.css dist/ui.css",
    "build": "npm run build:ui && npm run build:app"
  },
  "dependencies": {
    "@beach-finder/ui": "0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
